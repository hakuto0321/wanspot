# Wan Spot の環境変数の雛形。コピーして .env.local を作る（.env.local はコミットしない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # pipeline からのみ使用
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # HTTPリファラ制限をかける
GOOGLE_PLACES_API_KEY=            # サーバー側のみ
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HOTPEPPER_API_KEY=

# AI（任意）
AI_PROVIDER=claude                # claude / openai
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1
